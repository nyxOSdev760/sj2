{
  "name": "sj2",
  "version": "1.0.0",
  "private": true,
  "description": "A web proxy built on servy2, a fork of Scramjet 2",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "server": "cargo run --release --manifest-path server/Cargo.toml",
    "build": "node scripts/servy2.js && node scripts/build.js",
    "postinstall": "node scripts/servy2.js"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/wisp-js": "0.5.0"
  },
  "engines": {
    "node": ">=20.10"
  }
}
